# Generated by timing/pin_timing.py --write-sdc (grades 4/6/8 MHz, 50 ns); do not edit.
# chip_top against the NMOS Z80's AC characteristics: Zilog PS0178, Z8400
# (NMOS) table (z8400_nmos.json). Each pin parameter at the strictest of the
# 4/6/8 MHz grades, each at its own AC test conditions -- its edges (15, 16, 7.5 ns),
# inputs valid at 2.0 / 0.8 V, outputs at 1.5 V into 100 pF -- at every corner, the pads as
# RZ80 simulated them at transistor level (spice/pads/gf180mcu/), in ns from
# the CLK pin's 50 % for this STA's 7.5 ns edges. One clock, CLK, at the CLK pin:
# 50 ns (20 MHz), the core's goal, timed on those edges (on 15 ns ones
# the Schmitt CLK pad delays the clock's fall some 6 ns more than its rise: nothing
# at 4-8 MHz, a quarter of a half-cycle at 20 MHz). The parameters that depend
# on the clock (pulse widths, separations) are pin_timing.py's, at each grade's
# own clock (make pin-timing).
current_design $::env(DESIGN_NAME)
# at the CLK pin: the CLK pad and the clock tree are in every path, the I/O
# ones as in the datasheet's measurements
create_clock -name CLK -period 50 -waveform {0 25} [get_ports clk_PAD]
set_input_transition 7.5 [get_ports clk_PAD]
set_load 100 [get_ports {bidir_PAD[8] bidir_PAD[9] bidir_PAD[10] bidir_PAD[11] bidir_PAD[12] bidir_PAD[13] bidir_PAD[14] bidir_PAD[15] bidir_PAD[16] bidir_PAD[17] bidir_PAD[18] bidir_PAD[19] bidir_PAD[20] bidir_PAD[21] bidir_PAD[22] bidir_PAD[23] bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7] bidir_PAD[24] bidir_PAD[25] bidir_PAD[26] bidir_PAD[27] bidir_PAD[28] bidir_PAD[29] bidir_PAD[30] bidir_PAD[31]}]
set_input_transition 7.5 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7] input_PAD[0] input_PAD[1] input_PAD[2] input_PAD[3] rst_n_PAD}]
# each pin parameter is from one CLK edge: an output launched on the other
# edge, an input caught on it, is not held to it (RZ80's z80_chip SDC keeps
# them apart with a virtual clock for the pins; here, the paths through the
# pads)
set out_pads [get_pins -quiet {bidir\[8\].pad/A bidir\[9\].pad/A bidir\[10\].pad/A bidir\[11\].pad/A bidir\[12\].pad/A bidir\[13\].pad/A bidir\[14\].pad/A bidir\[15\].pad/A bidir\[16\].pad/A bidir\[17\].pad/A bidir\[18\].pad/A bidir\[19\].pad/A bidir\[20\].pad/A bidir\[21\].pad/A bidir\[22\].pad/A bidir\[23\].pad/A bidir\[0\].pad/A bidir\[1\].pad/A bidir\[2\].pad/A bidir\[3\].pad/A bidir\[4\].pad/A bidir\[5\].pad/A bidir\[6\].pad/A bidir\[7\].pad/A bidir\[24\].pad/A bidir\[25\].pad/A bidir\[26\].pad/A bidir\[27\].pad/A bidir\[28\].pad/A bidir\[29\].pad/A bidir\[30\].pad/A bidir\[31\].pad/A bidir\[8\].pad/OE bidir\[9\].pad/OE bidir\[10\].pad/OE bidir\[11\].pad/OE bidir\[12\].pad/OE bidir\[13\].pad/OE bidir\[14\].pad/OE bidir\[15\].pad/OE bidir\[16\].pad/OE bidir\[17\].pad/OE bidir\[18\].pad/OE bidir\[19\].pad/OE bidir\[20\].pad/OE bidir\[21\].pad/OE bidir\[22\].pad/OE bidir\[23\].pad/OE bidir\[0\].pad/OE bidir\[1\].pad/OE bidir\[2\].pad/OE bidir\[3\].pad/OE bidir\[4\].pad/OE bidir\[5\].pad/OE bidir\[6\].pad/OE bidir\[7\].pad/OE bidir\[24\].pad/OE bidir\[25\].pad/OE bidir\[26\].pad/OE bidir\[27\].pad/OE bidir\[28\].pad/OE bidir\[29\].pad/OE bidir\[30\].pad/OE bidir\[31\].pad/OE}]
set in_pads [get_pins -quiet {bidir\[0\].pad/Y bidir\[1\].pad/Y bidir\[2\].pad/Y bidir\[3\].pad/Y bidir\[4\].pad/Y bidir\[5\].pad/Y bidir\[6\].pad/Y bidir\[7\].pad/Y inputs\[0\].pad/Y inputs\[1\].pad/Y inputs\[2\].pad/Y inputs\[3\].pad/Y rst_n_pad/Y}]
foreach pads [list $out_pads $in_pads] {
    if { [llength $pads] > 0 } {
        set_false_path -rise_from [get_clocks CLK] -through $pads -fall_to [get_clocks CLK]
        set_false_path -fall_from [get_clocks CLK] -through $pads -rise_to [get_clocks CLK]
    }
}
# NMI is edge-triggered and asynchronous (the pulse catcher in z80_top)
set_false_path -from [get_ports {input_PAD[2]}]
# (z80_chip's RESET -> address false path has no counterpart: chip_top's
# address pads follow z80_top's addr_drive, which RESET reaches only through
# its rising-edge sampler)
# MREQ IORQ RD WR float in a bus grant only and come back high: their
# pads, enabled by z80_top's ctl_drive, never turn on driving low
set strobe_oe [get_pins -quiet {bidir\[25\].pad/OE bidir\[26\].pad/OE bidir\[27\].pad/OE bidir\[28\].pad/OE}]
if { [llength $strobe_oe] > 0 } { set_false_path -rise_through $strobe_oe -fall_to [get_ports {bidir_PAD[25] bidir_PAD[26] bidir_PAD[27] bidir_PAD[28]}] }
# read data is held until RD (IORQ in INTA) rises, not 0 ns past the
# sampling edge (P16 ThD(RDr)): pin_timing.py checks the replica's hold
# against its own RD / IORQ rise; the flow does not repair a hold the
# datasheet does not ask for
set_false_path -hold -from [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]
# the data pads' input enables follow the CPU's data drive: the input
# buffers turn on when the CPU stops driving the bus, a half cycle or more
# before the next read samples the pads; IE -> Y is no path the Z80 uses
set ie_pins [get_pins -quiet -hierarchical */IE]
if { [llength $ie_pins] > 0 } { set_false_path -through $ie_pins }
# no edge, load or fanout limit on the design: OpenSTA would hold every
# pin to it, the pads' board side too, which drives and takes the
# datasheet's 100 pF and slow edges. The core's limits (the PDK's
# MAX_TRANSITION / MAX_CAPACITANCE / MAX_FANOUT_CONSTRAINT) are in the
# standard cells' libraries (scripts/cell_limits.py), the pads' range in
# theirs (spice/pads/)
set_clock_uncertainty $::env(CLOCK_UNCERTAINTY_CONSTRAINT) [get_clocks CLK]
set_clock_transition $::env(CLOCK_TRANSITION_CONSTRAINT) [get_clocks CLK]
set_timing_derate -early [expr 1 - $::env(TIME_DERATING_CONSTRAINT) / 100.0]
set_timing_derate -late [expr 1 + $::env(TIME_DERATING_CONSTRAINT) / 100.0]
# ideal before CTS, propagated after (LibreLane's OPENLANE_SDC_IDEAL_CLOCKS)
if { [info exists ::env(OPENLANE_SDC_IDEAL_CLOCKS)] && $::env(OPENLANE_SDC_IDEAL_CLOCKS) } {
    unset_propagated_clock [get_clocks CLK]
} else {
    set_propagated_clock [get_clocks CLK]
}
# outputs: at 1.5 V at most D after the CLK pin's edge, and not before it:
# max T - D + (50 % -> 1.5 V) + (the CLK pad at the grade's edge - at this
# STA's), the strictest grade and corner; min the same CLK pad term
set_output_delay -add_delay -clock CLK -rise -max -24.162 [get_ports {bidir_PAD[8] bidir_PAD[9] bidir_PAD[10] bidir_PAD[11] bidir_PAD[12] bidir_PAD[13] bidir_PAD[14] bidir_PAD[15] bidir_PAD[16] bidir_PAD[17] bidir_PAD[18] bidir_PAD[19] bidir_PAD[20] bidir_PAD[21] bidir_PAD[22] bidir_PAD[23]}]   ;# P6 TdCr(A), P44 TdCr(Az) <= 70 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -max -13.683 [get_ports {bidir_PAD[8] bidir_PAD[9] bidir_PAD[10] bidir_PAD[11] bidir_PAD[12] bidir_PAD[13] bidir_PAD[14] bidir_PAD[15] bidir_PAD[16] bidir_PAD[17] bidir_PAD[18] bidir_PAD[19] bidir_PAD[20] bidir_PAD[21] bidir_PAD[22] bidir_PAD[23]}]   ;# P6 TdCr(A), P44 TdCr(Az) <= 70 (8 MHz)
set_output_delay -add_delay -clock CLK -min -1.469 [get_ports {bidir_PAD[8] bidir_PAD[9] bidir_PAD[10] bidir_PAD[11] bidir_PAD[12] bidir_PAD[13] bidir_PAD[14] bidir_PAD[15] bidir_PAD[16] bidir_PAD[17] bidir_PAD[18] bidir_PAD[19] bidir_PAD[20] bidir_PAD[21] bidir_PAD[22] bidir_PAD[23]}]
set_output_delay -add_delay -clock CLK -clock_fall -rise -max -69.162 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P53 TdCf(D) <= 115 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -fall -max -58.683 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P53 TdCf(D) <= 115 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -min 0 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]
set_output_delay -add_delay -clock CLK -rise -max -24.162 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P42 TdCr(Dz) <= 70 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -max -13.683 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P42 TdCr(Dz) <= 70 (8 MHz)
set_output_delay -add_delay -clock CLK -min -1.469 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]
set_output_delay -add_delay -clock CLK -clock_fall -fall -max -3.683 [get_ports {bidir_PAD[25]}]   ;# P8 TdCf(MREQf) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -fall -min 0 [get_ports {bidir_PAD[25]}]
set_output_delay -add_delay -clock CLK -clock_fall -rise -max -14.162 [get_ports {bidir_PAD[25]}]   ;# P12 TdCf(MREQr) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -rise -min 0 [get_ports {bidir_PAD[25]}]
set_output_delay -add_delay -clock CLK -rise -max -14.162 [get_ports {bidir_PAD[25]}]   ;# P9 TdCr(MREQr), P43 TdCr(CTz) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -rise -min -1.469 [get_ports {bidir_PAD[25]}]
set_output_delay -add_delay -clock CLK -fall -max -3.683 [get_ports {bidir_PAD[25]}]   ;# P43 TdCr(CTz) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -min -1.469 [get_ports {bidir_PAD[25]}]
set_output_delay -add_delay -clock CLK -clock_fall -fall -max -13.683 [get_ports {bidir_PAD[27]}]   ;# P13 TdCf(RDf) <= 70 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -fall -min 0 [get_ports {bidir_PAD[27]}]
set_output_delay -add_delay -clock CLK -clock_fall -rise -max -14.162 [get_ports {bidir_PAD[27]}]   ;# P23 TdCf(RDr) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -rise -min 0 [get_ports {bidir_PAD[27]}]
set_output_delay -add_delay -clock CLK -rise -max -14.162 [get_ports {bidir_PAD[27]}]   ;# P14 TdCr(RDr), P43 TdCr(CTz) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -rise -min -1.469 [get_ports {bidir_PAD[27]}]
set_output_delay -add_delay -clock CLK -fall -max -3.683 [get_ports {bidir_PAD[27]}]   ;# P24 TdCr(RDf), P43 TdCr(CTz) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -min -1.469 [get_ports {bidir_PAD[27]}]
set_output_delay -add_delay -clock CLK -fall -max 1.317 [get_ports {bidir_PAD[26]}]   ;# P27 TdCr(IORQf), P43 TdCr(CTz) <= 55 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -min -1.469 [get_ports {bidir_PAD[26]}]
set_output_delay -add_delay -clock CLK -rise -max -14.162 [get_ports {bidir_PAD[26]}]   ;# P52 TdCr(IORQr), P43 TdCr(CTz) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -rise -min -1.469 [get_ports {bidir_PAD[26]}]
set_output_delay -add_delay -clock CLK -clock_fall -rise -max -14.162 [get_ports {bidir_PAD[26]}]   ;# P28 TdCf(IORQr) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -rise -min 0 [get_ports {bidir_PAD[26]}]
set_output_delay -add_delay -clock CLK -clock_fall -fall -max -3.683 [get_ports {bidir_PAD[26]}]   ;# P51 TdCf(IORQf) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -fall -min 0 [get_ports {bidir_PAD[26]}]
set_output_delay -add_delay -clock CLK -clock_fall -fall -max -3.683 [get_ports {bidir_PAD[28]}]   ;# P30 TdCf(WRf) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -fall -min 0 [get_ports {bidir_PAD[28]}]
set_output_delay -add_delay -clock CLK -clock_fall -rise -max -14.162 [get_ports {bidir_PAD[28]}]   ;# P32 TdCf(WRr) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -rise -min 0 [get_ports {bidir_PAD[28]}]
set_output_delay -add_delay -clock CLK -fall -max 1.317 [get_ports {bidir_PAD[28]}]   ;# P34 TdCr(WRf), P43 TdCr(CTz) <= 55 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -min -1.469 [get_ports {bidir_PAD[28]}]
set_output_delay -add_delay -clock CLK -rise -max -14.162 [get_ports {bidir_PAD[28]}]   ;# P43 TdCr(CTz) <= 60 (8 MHz)
set_output_delay -add_delay -clock CLK -rise -min -1.469 [get_ports {bidir_PAD[28]}]
set_output_delay -add_delay -clock CLK -fall -max -13.683 [get_ports {bidir_PAD[24]}]   ;# P19 TdCr(M1f) <= 70 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -min -1.469 [get_ports {bidir_PAD[24]}]
set_output_delay -add_delay -clock CLK -rise -max -24.162 [get_ports {bidir_PAD[24]}]   ;# P20 TdCr(M1r) <= 70 (8 MHz)
set_output_delay -add_delay -clock CLK -rise -min -1.469 [get_ports {bidir_PAD[24]}]
set_output_delay -add_delay -clock CLK -fall -max -38.683 [get_ports {bidir_PAD[29]}]   ;# P21 TdCr(RFSHf) <= 95 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -min -1.469 [get_ports {bidir_PAD[29]}]
set_output_delay -add_delay -clock CLK -rise -max -39.162 [get_ports {bidir_PAD[29]}]   ;# P22 TdCr(RFSHr) <= 85 (8 MHz)
set_output_delay -add_delay -clock CLK -rise -min -1.469 [get_ports {bidir_PAD[29]}]
set_output_delay -add_delay -clock CLK -clock_fall -rise -max -179.162 [get_ports {bidir_PAD[30]}]   ;# P36 TdCf(HALT) <= 225 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -fall -max -168.683 [get_ports {bidir_PAD[30]}]   ;# P36 TdCf(HALT) <= 225 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -min 0 [get_ports {bidir_PAD[30]}]
set_output_delay -add_delay -clock CLK -fall -max -23.683 [get_ports {bidir_PAD[31]}]   ;# P40 TdCr(BUSACKf) <= 80 (8 MHz)
set_output_delay -add_delay -clock CLK -fall -min -1.469 [get_ports {bidir_PAD[31]}]
set_output_delay -add_delay -clock CLK -clock_fall -rise -max -34.162 [get_ports {bidir_PAD[31]}]   ;# P41 TdCf(BUSACKr) <= 80 (8 MHz)
set_output_delay -add_delay -clock CLK -clock_fall -rise -min 0 [get_ports {bidir_PAD[31]}]
# inputs: valid S before the sampling edge, held H after it, at the levels:
# max T - S, min H, each + (level -> 50 %) + (the input pad at the grade's
# edge - at this STA's) - (the CLK pad likewise), the strictest grade and corner
set_input_delay -add_delay -clock CLK -rise -max 22.077 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P15 TsD(Cr) = 30 (6 MHz)
set_input_delay -add_delay -clock CLK -rise -min 3.021 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P16 ThD(RDr) = 0 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -max 16.979 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P15 TsD(Cr) = 30 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -min -1.278 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P16 ThD(RDr) = 0 (8 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -rise -max 21.278 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P25 TsD(Cf) = 30 (8 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -rise -min 1.848 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P16 ThD(RDr) = 0 (6 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -fall -max 16.979 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P25 TsD(Cf) = 30 (8 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -fall -min -3.224 [get_ports {bidir_PAD[0] bidir_PAD[1] bidir_PAD[2] bidir_PAD[3] bidir_PAD[4] bidir_PAD[5] bidir_PAD[6] bidir_PAD[7]}]   ;# P16 ThD(RDr) = 0 (6 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -rise -max 1.278 [get_ports {input_PAD[0]}]   ;# P17 TsWAIT(Cf) = 50 (8 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -rise -min 1.848 [get_ports {input_PAD[0]}]   ;# P18 ThWAIT(Cf) = 0 (6 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -fall -max -3.021 [get_ports {input_PAD[0]}]   ;# P17 TsWAIT(Cf) = 50 (8 MHz)
set_input_delay -add_delay -clock CLK -clock_fall -fall -min -3.224 [get_ports {input_PAD[0]}]   ;# P18 ThWAIT(Cf) = 0 (6 MHz)
set_input_delay -add_delay -clock CLK -rise -max 11.278 [get_ports {input_PAD[3]}]   ;# P38 TsBUSREQ(Cr) = 40 (8 MHz)
set_input_delay -add_delay -clock CLK -rise -min 3.021 [get_ports {input_PAD[3]}]   ;# P39 ThBUSREQ(Cr) = 0 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -max 6.979 [get_ports {input_PAD[3]}]   ;# P38 TsBUSREQ(Cr) = 40 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -min -1.278 [get_ports {input_PAD[3]}]   ;# P39 ThBUSREQ(Cr) = 0 (8 MHz)
set_input_delay -add_delay -clock CLK -rise -max 6.278 [get_ports {rst_n_PAD}]   ;# P46 TsRESET(Cr) = 45 (8 MHz)
set_input_delay -add_delay -clock CLK -rise -min 3.021 [get_ports {rst_n_PAD}]   ;# P47 ThRESET(Cr) = 0 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -max 1.979 [get_ports {rst_n_PAD}]   ;# P46 TsRESET(Cr) = 45 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -min -1.278 [get_ports {rst_n_PAD}]   ;# P47 ThRESET(Cr) = 0 (8 MHz)
set_input_delay -add_delay -clock CLK -rise -max -3.722 [get_ports {input_PAD[1]}]   ;# P48 TsINT(Cr) = 55 (8 MHz)
set_input_delay -add_delay -clock CLK -rise -min 3.021 [get_ports {input_PAD[1]}]   ;# P49 ThINT(Cr) = 0 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -max -8.021 [get_ports {input_PAD[1]}]   ;# P48 TsINT(Cr) = 55 (8 MHz)
set_input_delay -add_delay -clock CLK -fall -min -1.278 [get_ports {input_PAD[1]}]   ;# P49 ThINT(Cr) = 0 (8 MHz)
