MAKEFILE_DIR := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

RUN_TAG = $(shell ls librelane/runs/ | tail -n 1)
TOP = chip_top

PDK_ROOT ?= $(MAKEFILE_DIR)/gf180mcu
PDK ?= gf180mcuD
PDK_COMMIT ?= 792ef67037d74c8c51811eab3ce23cf793491296

# Available SCL libraries:
# gf180mcu_as_sc_mcu7t3v3
# gf180mcu_fd_sc_mcu7t5v0
# gf180mcu_fd_sc_mcu9t5v0
# gf180mcu_ocd_sc_rt12t3v3
# gf180mcu_osu_sc_gp9t3v3 (broken)
# gf180mcu_osu_sc_gp12t3v3 (broken)

# The Z80 chip: the 7-track 5 V library (the template's default)
ifeq ($(SCL),default)
    SCL = gf180mcu_fd_sc_mcu7t5v0
endif
SCL ?= gf180mcu_fd_sc_mcu7t5v0

# Available PAD libraries:
# gf180mcu_fd_io
# gf180mcu_ocd_io

ifeq ($(PAD),default)
    PAD = gf180mcu_fd_io
endif
PAD ?= gf180mcu_fd_io

# Available SRAM macros:
# gf180mcu_fd_ip_sram
# gf180mcu_ocd_ip_sram

ifeq ($(SRAM),default)
    SRAM = gf180mcu_fd_ip_sram
endif
SRAM ?= gf180mcu_fd_ip_sram

ifeq ($(SRAM),gf180mcu_fd_ip_sram)
    MACROS = 5v
else
    MACROS = 3v3
endif

# The Z80 is laid out for the quarter slot only (librelane/slots/slot_0p5x0p5.yaml);
# the other slot files are the template's, without the Z80's pad mapping.
AVAILABLE_SLOTS = 0p5x0p5
DEFAULT_SLOT = 0p5x0p5

# Slot can be any of AVAILABLE_SLOTS
SLOT ?= $(DEFAULT_SLOT)

ifeq ($(SLOT),default)
    SLOT = $(DEFAULT_SLOT)
endif

ifeq ($(filter $(SLOT),$(AVAILABLE_SLOTS)),)
    $(error $(SLOT) does not exist in AVAILABLE_SLOTS: $(AVAILABLE_SLOTS))
endif

SLOT_DEFINE = SLOT_$(shell echo $(SLOT) | tr '[:lower:]' '[:upper:]')
SRAM_DEFINE = SRAM_$(SRAM)

LIBRELANE_OPTS = --pdk ${PDK} --pdk-root ${PDK_ROOT} --manual-pdk --scl ${SCL} --pad ${PAD}
LIBRELANE_CONFIGS = librelane/slots/slot_${SLOT}.yaml librelane/macros/macros_${MACROS}.yaml librelane/config.yaml

.DEFAULT_GOAL := help

help: ## Show this help message
	@echo 'Usage: make [target]'
	@echo ''
	@echo 'Available targets:'
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'
.PHONY: help

all: librelane ## Build the project (runs LibreLane)
.PHONY: all

$(PDK_ROOT)/ciel/gf180mcu/versions/$(PDK_COMMIT)/$(PDK):
	ciel enable $(PDK_COMMIT) --pdk-root $(PDK_ROOT) --pdk $(PDK) --include-libraries all

clone-pdk: $(PDK_ROOT)/ciel/gf180mcu/versions/$(PDK_COMMIT)/$(PDK) ## Clone the gf180mcu PDK
.PHONY: clone-pdk

# Need to find a better way to
# pass the variables to LibreLane
defines:
	@echo "Writing src/generated_defines.svh"
	$(file >src/generated_defines.svh,// This file is auto-generated by the Makefile)
	$(file >>src/generated_defines.svh,`define ${SLOT_DEFINE})
	$(file >>src/generated_defines.svh,`define ${SRAM_DEFINE})
	$(file >>src/generated_defines.svh,`define SCL_${SCL})
.PHONY: defines

librelane: clone-pdk defines ## Run LibreLane flow (synthesis, PnR, verification)
	SRAM_DEFINE=${SRAM_DEFINE} librelane ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS} --save-views-to $(MAKEFILE_DIR)/final
.PHONY: librelane

librelane-condensed: clone-pdk defines ## Run LibreLane flow (synthesis, PnR, verification)
	SRAM_DEFINE=${SRAM_DEFINE} librelane --condensed ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS} --save-views-to $(MAKEFILE_DIR)/final
.PHONY: librelane-condensed

librelane-nodrc: clone-pdk defines ## Run LibreLane flow without DRC checks
	SRAM_DEFINE=${SRAM_DEFINE} librelane ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS} --save-views-to $(MAKEFILE_DIR)/final --skip KLayout.Antenna --skip KLayout.DRC --skip Magic.DRC
.PHONY: librelane-nodrc

librelane-klayoutdrc: clone-pdk defines ## Run LibreLane flow without magic DRC checks
	SRAM_DEFINE=${SRAM_DEFINE} librelane ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS} --save-views-to $(MAKEFILE_DIR)/final --skip Magic.DRC
.PHONY: librelane-klayoutdrc

librelane-magicdrc: clone-pdk defines ## Run LibreLane flow without KLayout DRC checks
	SRAM_DEFINE=${SRAM_DEFINE} librelane ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS} --save-views-to $(MAKEFILE_DIR)/final --skip KLayout.DRC
.PHONY: librelane-magicdrc

librelane-openroad: clone-pdk defines ## Open the last run in OpenROAD
	SRAM_DEFINE=${SRAM_DEFINE} librelane ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS} --last-run --flow OpenInOpenROAD
.PHONY: librelane-openroad

librelane-klayout: clone-pdk defines ## Open the last run in KLayout
	SRAM_DEFINE=${SRAM_DEFINE} librelane ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS} --last-run --flow OpenInKLayout
.PHONY: librelane-klayout

librelane-padring: clone-pdk defines ## Only create the padring
	python3 scripts/padring.py ${LIBRELANE_CONFIGS} ${LIBRELANE_OPTS}
.PHONY: librelane-padring

sim: clone-pdk defines ## Run RTL simulation with cocotb
	cd cocotb; PDK_ROOT=${PDK_ROOT} PDK=${PDK} SLOT=${SLOT} PAD=${PAD} SCL=${SCL} SRAM=${SRAM} python3 chip_top_tb.py
.PHONY: sim

sim-gl: clone-pdk defines ## Run gate-level simulation with cocotb (after copy-final)
	cd cocotb; GL=1 PDK_ROOT=${PDK_ROOT} PDK=${PDK} SLOT=${SLOT} PAD=${PAD} SCL=${SCL} SRAM=${SRAM} python3 chip_top_tb.py
.PHONY: sim-gl

sim-system: clone-pdk defines ## Run whole programs on the chip's RTL (cocotb, cocotb/system_tb.py)
	cd cocotb; PDK_ROOT=${PDK_ROOT} PDK=${PDK} SCL=${SCL} PAD=${PAD} python3 system_tb.py
.PHONY: sim-system

sim-system-gl: clone-pdk defines ## Run whole programs on the chip's gate-level netlist (cocotb, after copy-final)
	cd cocotb; GL=1 PDK_ROOT=${PDK_ROOT} PDK=${PDK} SCL=${SCL} PAD=${PAD} python3 system_tb.py
.PHONY: sim-system-gl

sim-view: ## View simulation waveforms in GTKWave
	gtkwave cocotb/sim_build/chip_top.fst
.PHONY: sim-view

# =============================================================================
# The tests (tests/README.md). RZ80's are in tests/rz80/, written by
# scripts/sync_rz80.py from the rz80/ submodule (RZ80 itself); they run on
# src/rz80/, never on the submodule's RTL. Test data under a third-party
# licence stays in rz80/ and is read from there.
# =============================================================================
RZ80_SRC   := $(sort $(wildcard src/rz80/*.v))
RZ80_BUILD := build/rz80
IVERILOG   ?= iverilog
VVP        ?= vvp
VERILATOR  ?= verilator
PYTHON     ?= python3
VERILATOR_FLAGS = --cc --exe --build -j 0 -O3 -Wall -Wno-fatal -Wno-WIDTH -Wno-CASEINCOMPLETE \
                  -Wno-UNUSEDSIGNAL --top-module z80_top -Isrc/rz80 $(RZ80_SRC)

sync-check: ## RZ80's files in ws3 are what scripts/sync_rz80.py writes from rz80/
	$(PYTHON) scripts/sync_rz80.py --check
.PHONY: sync-check

rz80-elab: ## RZ80's RTL elaborates (iverilog)
	$(IVERILOG) -g2001 -Isrc/rz80 -t null $(RZ80_SRC) && echo "RTL elaboration OK"
.PHONY: rz80-elab

rz80-bus: ## RZ80's bus-control testbenches: WAIT, write hold, INT acknowledge (iverilog)
	@mkdir -p $(RZ80_BUILD)
	set -e; for tb in tb_bus_controls tb_wait_edge tb_wait_write tb_int_ack; do \
	  $(IVERILOG) -g2012 -Isrc/rz80 -s $$tb -o $(RZ80_BUILD)/$$tb.vvp $(RZ80_SRC) tests/rz80/iverilog/$$tb.v; \
	  $(VVP) $(RZ80_BUILD)/$$tb.vvp; \
	done
.PHONY: rz80-bus

rz80-fuse: ## FUSE's 1356 tests, with the die's values where they differ (silicon.expected), through the RTL (iverilog)
	$(PYTHON) tests/rz80/scripts/compare_fuse_rtl.py
.PHONY: rz80-fuse

XYFLAGS := $(RZ80_BUILD)/xyflags
$(XYFLAGS)/%: rz80/tests/xyflags/%.xz
	@mkdir -p $(XYFLAGS)
	@$(PYTHON) -c "import lzma, sys; sys.stdout.buffer.write(lzma.open(sys.argv[1]).read())" $< > $@

rz80-xyflags: $(XYFLAGS)/tests.in $(XYFLAGS)/tests.expected ## The X / Y flag corpus (perfectz80's values) through the RTL (iverilog)
	FUSE_IN=$(XYFLAGS)/tests.in FUSE_EXPECTED=$(XYFLAGS)/tests.expected FUSE_FIX=/dev/null \
	  FUSE_TB=$(RZ80_BUILD)/tb_xyflags.v FUSE_VVP=$(RZ80_BUILD)/tb_xyflags.vvp FUSE_LABEL="X / Y corpus" \
	  $(PYTHON) tests/rz80/scripts/compare_fuse_rtl.py
.PHONY: rz80-xyflags

SWEEP_SHARD ?=
rz80-sweep: ## The pin sweep, half-cycle by half-cycle against perfectz80's recorded traces (iverilog; SWEEP_SHARD=k/n)
	@mkdir -p $(RZ80_BUILD)
	$(IVERILOG) -g2001 -Isrc/rz80 -s tb_event_sweep -o $(RZ80_BUILD)/tb_event_sweep.vvp \
	  $(RZ80_SRC) tests/rz80/iverilog/tb_event_sweep.v
	$(PYTHON) tests/rz80/scripts/event_sweep.py $(if $(SWEEP_SHARD),--shard $(SWEEP_SHARD))
.PHONY: rz80-sweep

# RZ80's Verilator harnesses (tests/rz80/verilator/sim_<name>.cpp) on src/rz80/
define verilator_sim
$(RZ80_BUILD)/obj_dir_$(1)/sim_$(1): tests/rz80/verilator/sim_$(1).cpp $(RZ80_SRC)
	@mkdir -p $(RZ80_BUILD)
	$(VERILATOR) $(VERILATOR_FLAGS) --Mdir $(RZ80_BUILD)/obj_dir_$(1) $$(abspath $$<) -o sim_$(1)
endef
$(foreach s,zex z80test basic,$(eval $(call verilator_sim,$(s))))

ZEX       ?= zexdoc
ZEX_TESTS ?=
rz80-zex: $(RZ80_BUILD)/obj_dir_zex/sim_zex ## ZEXDOC / ZEXALL through the RTL (Verilator): ZEX=zexall, ZEX_TESTS="0 5 9" for some of the 67 tests
	tests/run_zex.sh $(ZEX) $(ZEX_TESTS)
.PHONY: rz80-zex

Z80TEST ?= z80full
rz80-z80test: $(RZ80_BUILD)/obj_dir_z80test/sim_z80test ## Patrik Rak's z80test through the RTL (Verilator): Z80TEST=z80doc|z80flags|z80memptr|z80full|z80ccf
	stdbuf -oL $(RZ80_BUILD)/obj_dir_z80test/sim_z80test rz80/tests/z80test/$(Z80TEST).tap 8000000000
.PHONY: rz80-z80test

rz80-basic: $(RZ80_BUILD)/obj_dir_basic/sim_basic ## NASCOM BASIC 4.7 and Tiny BASIC through the RTL (Verilator)
	tests/rz80/basic/run_basic_tests.sh rtl
.PHONY: rz80-basic

# The pins against the NMOS Z80's AC characteristics (Zilog PS0178, Z8400, timing/),
# measured by OpenSTA on the latest run at every process corner, the pads as RZ80
# simulated them at transistor level (spice/pads/): GRADE=4 (Z80A), 6 or 8
STA   ?= $(shell command -v sta || command -v openroad)
GRADE ?= 4
pin-timing: ## The pins against the NMOS Z80's datasheet at 4 MHz, every corner (OpenSTA)
	STA="$(STA)" $(PYTHON) timing/pin_timing.py $$(ls -td librelane/runs/RUN_* | head -1) --grade $(GRADE)
.PHONY: pin-timing

# wafer.space's precheck of the GDS, at a pinned commit of
# https://github.com/wafer-space/gf180mcu-precheck, in that repository's own
# Nix shell (its LibreLane, the template's, plus qrcode and procps for the ID
# cells and the density deck). PRECHECK_SHELL= runs it in the current shell.
PRECHECK_COMMIT := 9b4e7dab6af073d02b81ecc368069540d2f67db9
PRECHECK_DIR    := build/precheck
PRECHECK_SHELL  ?= nix develop ./$(PRECHECK_DIR) --accept-flake-config --command
PRECHECK_PYTHON ?= python3
precheck: ## wafer.space's precheck of final/gds/chip_top.gds for the quarter slot
	@if [ ! -d $(PRECHECK_DIR)/.git ]; then \
	  git init -q $(PRECHECK_DIR) && \
	  git -C $(PRECHECK_DIR) fetch -q --depth=1 https://github.com/wafer-space/gf180mcu-precheck $(PRECHECK_COMMIT) && \
	  git -C $(PRECHECK_DIR) checkout -q FETCH_HEAD; fi
	mkdir -p build/precheck-run
	$(PRECHECK_SHELL) env PDK_ROOT=$(PDK_ROOT) PDK=$(PDK) $(PRECHECK_PYTHON) $(PRECHECK_DIR)/precheck.py \
	  --input final/gds/chip_top.gds --slot $(SLOT) --dir build/precheck-run
.PHONY: precheck
